PORT=5000
NODE_ENV=development

# Safe Recycler OTP Development Mode
# Set to 'true' to allow local developer login when real SMS provider is not configured.
# Logs the cryptographically generated 6-digit OTP ONLY to the backend terminal console.
# In production or when set to false, real SMS through MSG91/Fast2SMS is enforced.
RECYCLER_OTP_DEV_MODE=true

# SMS Gateway Configuration (MoEFCC & CPCB Compliance)
# When commercial gateway credentials are not configured, RECYCLER_OTP_DEV_MODE enables local dev testing.
# Set SMS_PROVIDER to MSG91 or FAST2SMS and provide SMS_API_KEY when commercial DLT routes are active.
SMS_PROVIDER=LOCAL_SIMULATOR
SMS_API_KEY=
SMS_SENDER_ID=KBDWLA
SMS_TEMPLATE_ID=KBDWLA_OTP_VERIFY
JWT_SECRET=kabadiwala_connect_sih2026_super_secret_jwt_key

# SIH Judge Demo / Jury Evaluation Access
# When JUDGE_DEMO_ENABLED=true in non-production, allows the fixed 6-digit demo OTP for Recycler role
JUDGE_DEMO_ENABLED=true
JUDGE_DEMO_OTP=123456
