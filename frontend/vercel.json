{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-BACKEND-DOMAIN-HERE/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://YOUR-BACKEND-DOMAIN-HERE/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
